# Google Gemini API Key (used for embedding & generative AI mechanics)
GEMINI_API_KEY="your-gemini-api-key"

# Supabase Database & Auth URL
SUPABASE_URL="https://your-project.supabase.co"

# Supabase Public Anon Key
SUPABASE_KEY="your-supabase-anon-key"

# Secret token required to trigger administrative knowledge base ingestion
INGEST_SECRET="your-ingest-secret-token"

# Port to bind for Uvicorn (default: 7860)
PORT=7860
